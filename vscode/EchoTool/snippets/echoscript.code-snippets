    "description": "Move the player spawn/action position.",
    "body": [
      "Player.SpawnAt(${1:x}, ${2:y}, ${3:z}, yaw: ${4:0}, pitch: ${5:0});"
    ]
  },
  "Npc.SpawnAt": {
    "prefix": "Npc.SpawnAt",
    "description": "Spawn an NPC through the new external action intrinsic.",
    "body": [
      "Npc.SpawnAt(${1:NpcRef}, ${2:x}, ${3:y}, ${4:z}, yaw: ${5:0}, pitch: ${6:0});"
    ]
  },
  "Sleep.EnterDream": {
    "prefix": "Sleep.EnterDream",
    "description": "Enter a sleep dream target.",
    "body": [
      "Sleep.EnterDream(target: \"${1:chapter_1_dream}\", x: ${2:x}, y: ${3:y}, z: ${4:z}, yaw: ${5:0}, pitch: ${6:0});"
    ]
