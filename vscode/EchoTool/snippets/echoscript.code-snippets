      "LineAfterMove(\"${1:speaker}\", \"${2:Text}.\");"
    ]
  },
  "Choice": {
    "prefix": "Choice",
    "description": "Dialogue choice with next node.",
    "body": [
      "Choice(\"${1:choice_id}\", \"${2:Choice text}.\", next: \"${3:next_node}\");"
    ]
  },
  "Complete": {
    "prefix": "Complete",
    "description": "Dialogue completion outcome.",
    "body": [
      "Complete(\"${1:jdh:outcome_id}\");"
    ]
  },
  "StateRef": {
    "prefix": "StateRef",
    "description": "Local runtime story state reference.",
    "body": [
      "private StateRef ${1:stateName} = State.Memory(\"${2:chapter.state_key}\");"
    ]
  },
  "Set": {
    "prefix": "Set",
    "description": "Runtime state write effect.",
    "body": [
      "Set(${1:stateName}, ${2:true});"
    ]
  },
  "Npc.Spawn": {
    "prefix": "Npc.Spawn",
    "description": "Typed NPC spawn helper for legacy effect contexts.",
    "body": [
      "Npc.Spawn(${1:NpcRef}, ${2:Overworld}, ${3:x}, ${4:y}, ${5:z});"
    ]
  },
  "Environment.Set": {
    "prefix": "Environment.Set",
    "description": "Apply an EnvironmentResource state.",
    "body": [
      "Environment.Set(${1:Environments.Environment}, \"${2:state_id}\");"
    ]
  },
  "Dialogue.Load": {
    "prefix": "Dialogue.Load",
    "description": "Load a modular dialogue action.",
    "body": [
      "Dialogue.Load(${1:Dialogues.Dialogue}, audienceId: \"${2:player}\");"
    ]
  },
  "Story.Load": {
    "prefix": "Story.Load",
    "description": "Start another StoryResource.",
