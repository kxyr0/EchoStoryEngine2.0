{
  "StoryResource": {
    "prefix": "StoryResource",
    "description": "New Echo Story graph resource.",
    "body": [
      "namespace JDH.${1:Chapter};",
      "",
      "class ${2:ExampleStory} : StoryResource",
      "{",
      "    public override StoryResourceDef Build()",
      "    {",
      "        return Story(\"${3:jdh:example_story}\", start: \"${4:start}\");",
      "    }",
      "",
      "    private void Nodes()",
      "    {",
      "        Start(\"${4:start}\", next: \"${5:play_dialogue}\");",
      "        Action(",
      "            \"${5:play_dialogue}\",",
      "            type: \"echo_dialogue:play\",",
      "            dialogueId: \"${6:jdh:example_dialogue}\",",
      "            audienceId: \"${7:jdh:local_author}\",",
      "            output: \"${8:outcome}\",",
      "            next: \"${9:finish}\");",
      "        Finish(\"${9:finish}\");",
      "    }",
      "}"
    ]
  },
  "Story Action: dialogue": {
    "prefix": "StoryActionDialogue",
    "description": "Story graph action that starts an Echo Dialogue resource.",
    "body": [
      "Action(",
      "    \"${1:play_dialogue}\",",
      "    type: \"echo_dialogue:play\",",
      "    dialogueId: \"${2:jdh:dialogue_id}\",",
      "    audienceId: \"${3:jdh:local_author}\",",
      "    output: \"${4:outcome}\",",
      "    next: \"${5:next_node}\");"
    ]
  },
  "Story Action: NPC spawn": {
    "prefix": "StoryActionNpcSpawn",
    "description": "Story graph action that spawns an Echo NPC actor.",
    "body": [
      "Action(",
      "    \"${1:spawn_actor}\",",
      "    type: \"echo_npc:spawn\",",
      "    actorId: \"${2:jdh:actor_id}\",",
      "    definitionId: \"${3:jdh:npc_definition}\",",
      "    worldId: \"minecraft:overworld\",",
      "    x: \"${4:0}\",",
      "    y: \"${5:64}\",",
      "    z: \"${6:0}\",",
      "    yaw: \"${7:0}\",",
      "    pitch: \"${8:0}\",",
      "    output: \"${9:result}\",",
      "    next: \"${10:next_node}\");"
    ]
  },
  "Story Set node": {
    "prefix": "StorySet",
    "description": "Story graph state write node.",
    "body": [
      "Set(",
      "    \"${1:set_state}\",",
      "    variable: \"${2:jdh.chapter.state_key}\",",
      "    value: ${3:true},",
      "    next: \"${4:next_node}\");"
    ]
  },
  "DialogueResource": {
    "prefix": "DialogueResource",
    "description": "Minimal high-level Echo Dialogue resource; id comes from the resource filename.",
    "body": [
      "class ${1:ExampleDialogue} : DialogueResource",
      "{",
      "    Node ${2:FirstMeeting}()",
      "    {",
      "        Line(\"${3:john}\", \"${4:Line text}\", thought: ${5:false});",
      "    }",
      "}"
    ]
  },
  "DialogueResource (multi-node)": {
    "prefix": "DialogueResourceMulti",
    "description": "High-level dialogue graph with an explicit start Node and symbolic GoTo.",
    "body": [
      "class ${1:ExampleDialogue} : DialogueResource",
      "{",
      "    start Node ${2:Opening}()",
      "    {",
      "        Line(\"${3:john}\", \"${4:Opening line}\");",
      "        GoTo(${5:Continue});",
      "    }",
      "",
      "    Node ${5:Continue}()",
      "    {",
      "        Line(\"${3:john}\", \"${6:Final line}\");",
      "    }",
      "}"
    ]
  },
