      "            display: \"${4:Character}\",",
      "            skin: Skin(\"${3:jdh:example_npc}\"),",
      "            defaultForm: DefaultForm(\"${5:jdh:example_npc/default}\")",
      "        );",
      "    }",
      "}"
    ]
  },
  "NpcFormResource": {
    "prefix": "NpcFormResource",
    "description": "Echo NPC authored form resource.",
    "body": [
