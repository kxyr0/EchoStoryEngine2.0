  },
  "AnimationClipResource": {
    "prefix": "AnimationClipResource",
    "description": "Echo Animation normalized body clip resource.",
    "body": [
      "namespace JDH.Animation.${1:Chapter};",
      "",
      "class ${2:ExampleAnimationClip} : AnimationClipResource",
      "{",
      "    public override AnimationClipDef Build()",
      "    {",
      "        return AnimationClip(\"${3:jdh:example_clip}\", rig: \"${4:jdh:humanoid}\",",
      "            tracks: [",
      "                Track(\"${5:right_forearm}\", frames: [",
      "                    Frame(\"0.0\").Rotation(0, 0, \"0.0\"),",
      "                    Frame(\"1.0\").Rotation(0, 0, \"0.0\")",
      "                ])",
      "            ]);",
      "    }",
      "}"
    ]
  },
  "FaceRigResource": {
    "prefix": "FaceRigResource",
    "description": "High-level Echo Animation face rig DSL resource.",
    "body": [
      "namespace JDH.Animation.${1:Chapter};",
      "",
      "face ${2:ExampleFace}(\"${3:jdh:example_face}\")",
      "{",
      "    Eyes",
      "    {",
      "        Sclera Left  { Position(-0.125, 0, 0); }",
      "        Sclera Right { Position( 0.125, 0, 0); }",
      "        Pupil Left   { Position(-0.09, 0, 0.01); }",
      "        Pupil Right  { Position( 0.09, 0, 0.01); }",
      "    }",
      "",
      "    Blink \"${4:eye_closure}\"",
      "    {",
      "        Travel(35, -35);",
      "        Idle(true);",
      "    }",
      "}"
    ]
  },
  "FacePoseResource": {
    "prefix": "FacePoseResource",
    "description": "Echo Animation face pose resource.",
    "body": [
      "namespace JDH.Animation.${1:Chapter};",
      "",
      "class ${2:ExampleFacePose} : FacePoseResource",
      "{",
      "    public override FacePoseDef Build()",
      "    {",
      "        return FacePose(\"${3:jdh:example_face/neutral}\", rig: \"${4:jdh:example_face}\",",
      "            bones: [BoneDelta(\"${5:face_root}\")],",
      "            controls: [ControlDelta(\"${6:eye_closure}\", value: ${7:0})]",
      "        );",
      "    }",
      "}"
    ]
  },
  "FacialAnimationResource": {
    "prefix": "FacialAnimationResource",
    "description": "Echo Animation facial animation resource.",
    "body": [
      "namespace JDH.Animation.${1:Chapter};",
      "",
      "class ${2:ExampleFacialAnimation} : FacialAnimationResource",
      "{",
      "    public override FacialAnimationDef Build()",
      "    {",
      "        return FacialAnimation(\"${3:jdh:example_face/look_left}\", rig: \"${4:jdh:example_face}\", surfaces: [World, Portrait]);",
      "    }",
      "}",
      "",
      "class World : FacialAnimationSurface3d",
      "{",
      "    private PhaseDef Enter()",
      "    {",
      "        return Phase(durationTicks: ${5:6}, tracks: [",
      "            Track(\"${6:left_pupil}\", frames: [Frame(0).Position(0, 0, 0), Frame(${5:6}).Position(\"-0.031\", 0, 0)])",
      "        ]);",
      "    }",
      "}",
      "",
      "class Portrait : FacialAnimationSurfacePortrait",
      "{",
      "    private PhaseDef Enter()",
      "    {",
      "        return Phase(durationTicks: ${7:6}, tracks: [",
      "            Track(\"${8:left_pupil}\", frames: [Frame(0).Position(0, 0, 0), Frame(${7:6}).Position(\"-0.031\", 0, 0)])",
      "        ]);",
      "    }",
      "}"
    ]
  },
  "dialogueNodes": {
    "prefix": "DialogueNode",
    "description": "High-level dialogue Node declaration.",
    "body": [
      "Node ${1:NextNode}()",
      "{",
      "    Line(\"${2:john}\", \"${3:Text}\");",
      "}"
    ]
  },
  "Alias": {
    "prefix": "Alias",
    "description": "Dialogue local alias declaration.",
    "body": [
      "Alias(\"${1:speaker}\", \"${2:jdh:speaker_id}\", display: \"${3:Speaker}\", visual: Portrait(\"${2:jdh:speaker_id}\"));"
    ]
  },
  "Line": {
    "prefix": "Line",
    "description": "Dialogue line using a local alias.",
    "body": [
      "Line(\"${1:speaker}\", \"${2:Text}.\");"
    ]
  },
  "LineAfterMove": {
    "prefix": "LineAfterMove",
    "description": "Dialogue line that waits for the matching Npc.Move arrival.",
