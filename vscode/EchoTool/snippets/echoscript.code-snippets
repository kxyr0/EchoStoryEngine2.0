      "Player.Teleport(instanceId: \"${1:chapter_1_blackspace}\", target: \"${2:entry}\");"
    ]
  },
  "TriggerResource": {
    "prefix": "TriggerResource",
    "description": "New Echo TriggerResource.",
    "body": [
      "namespace JDH.Triggers.${1:Chapter};",
      "",
      "class ${2:ExampleTrigger} : TriggerResource",
      "{",
      "    private Area ${3:HomeDoor} = Area(\"minecraft:overworld\", ${4:x}, ${5:y}, ${6:z}, ${7:sx}, ${8:sy}, ${9:sz});",
      "",
      "    private void Init()",
      "    {",
      "        Id(\"${10:jdh:example_trigger}\");",
      "        Scope(PLAYER);",
      "        Mode(REPEAT);",
      "        Start(${11:Sequence});",
      "    }",
      "",
      "    private void ${11:Sequence}()",
      "    {",
      "        Wait(PlayerEnter(${3:HomeDoor}));",
      "        StartStory(\"${12:jdh:example_story}\");",
      "    }",
      "}"
    ]
  },
