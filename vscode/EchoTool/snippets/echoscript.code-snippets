      "            skin: Skin(\"${4:jdh:example_npc}\"),",
      "            model: \"${5:default}\",",
      "            dimensions: Dimensions(${6:0.6}, ${7:1.8}, ${8:1.62}),",
      "            bodyScale: ${9:1.0},",
      "            parts: [Part(\"${10:head}\", scale: ${11:1.0})],",
      "            anchors: [Anchor(\"${12:dialogue}\", x: ${13:0}, y: ${14:1.8}, z: ${15:0})],",
      "            animationGraph: \"${16:jdh:standard_humanoid}\",",
      "            faceProfile: \"${17:jdh:example_face}\",",
      "            portrait: Portrait(\"${4:jdh:example_npc}\"),",
      "            tags: [\"${18:story}\"]",
      "        );",
      "    }",
      "}"
    ]
  },
  "EnvironmentResource": {
    "prefix": "EnvironmentResource",
    "description": "Echo Story environment resource with block-change states.",
    "body": [
      "namespace JDH.Environment.${1:Chapter};",
      "",
      "class ${2:ExampleEnvironment} : EnvironmentResource",
      "{",
      "    private DimensionId World = \"minecraft:overworld\";",
      "",
      "    public override EnvironmentResourceDef Build()",
      "    {",
      "        var states = [",
      "            ${3:Morning}()",
      "        ];",
      "",
      "        return Environment(\"${4:jdh:example_environment}\", World, states);",
      "    }",
      "",
      "    private EnvironmentStateDef ${3:Morning}()",
      "    {",
      "        return State(\"${5:morning}\", [",
      "            ClearBlock(Position(${6:x}, ${7:y}, ${8:z})),",
      "            SetBlock(Position(${9:x}, ${10:y}, ${11:z}), \"${12:minecraft:oak_planks}\", Properties(Property(\"${13:facing}\", \"${14:north}\")))",
      "        ]);",
      "    }",
      "}"
    ]
  },
  "NpcAnimationBindingResource": {
    "prefix": "NpcAnimationBindingResource",
    "description": "Echo NPC to Echo Animation profile binding resource.",
    "body": [
      "namespace JDH.NpcAnimation.${1:Chapter};",
      "",
      "class ${2:ExampleNpcAnimationBinding} : NpcAnimationBindingResource",
      "{",
      "    public override NpcAnimationBindingDef Build()",
      "    {",
      "        return NpcAnimationBinding(\"${3:jdh:example_npc_standard_humanoid}\",",
      "            npc: \"${4:jdh:example_npc}\",",
      "            profile: \"${5:jdh:standard_humanoid}\"",
      "        );",
      "    }",
      "}"
    ]
  },
  "AnimationResource": {
    "prefix": "AnimationResource",
    "description": "High-level Echo Animation lifecycle resource.",
    "body": [
      "namespace JDH.Animation.${1:Chapter};",
      "",
      "class ${2:ExampleAnimation} : AnimationResource",
      "{",
      "    public override AnimationDef Build()",
      "    {",
      "        return Animation(\"${3:jdh:example_animation}\",",
      "            channels: [Channel(\"${4:body}\")],",
      "            sources: [Source(\"${4:body}/idle\")],",
      "            entries: [Entry(\"${4:body}/idle\", clip: \"${5:jdh:example_enter}\", durationTicks: ${6:6})],",
      "            main: Main(clip: \"${7:jdh:example_loop}\", mode: \"LOOP_UNTIL_STOP\", durationTicks: ${8:24},",
      "                exitPoints: [ExitPoint(\"${9:neutral}\", progress: \"0.0\")]),",
      "            exits: [Exit(\"${9:neutral}\", clip: \"${10:jdh:example_exit}\", durationTicks: ${11:6})],",
      "            target: \"${4:body}/idle\",",
      "            recovery: Recovery(\"BOUNDED\", checkpointIntervalTicks: ${12:8}),",
      "            replay: \"REJECT_IF_RUNNING\");",
      "    }",
      "}"
    ]
  },
  "AnimationProfileResource": {
    "prefix": "AnimationProfileResource",
    "description": "Echo Animation subject profile resource.",
    "body": [
      "namespace JDH.Animation.${1:Chapter};",
      "",
      "class ${2:ExampleAnimationProfile} : AnimationProfileResource",
      "{",
      "    public override AnimationProfileDef Build()",
      "    {",
      "        return AnimationProfile(\"${3:jdh:standard_humanoid}\",",
      "            rig: \"${4:jdh:humanoid}\",",
      "            graph: \"${4:jdh:humanoid}\",",
      "            render: \"SEGMENTED_HUMANOID\",",
      "            initialStates: [InitialState(\"${5:body}\", state: \"${5:body}/idle\")],",
      "            requiredChannels: [Channel(\"${5:body}\")]",
      "        );",
      "    }",
      "}"
    ]
  },
