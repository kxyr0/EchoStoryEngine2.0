  "Inline event reaction": {
    "prefix": "when-event",
    "body": [
      "When(Dialogue.Completed(\"${1:jdh:father}\"), id: \"${2:after_father}\")",
      "{",
      "\tScene.Play(\"${3:jdh:father_leaves}\");",
      "}"
    ],
    "description": "Реакция на событие в DialogueResource, StoryResource или TriggerResource"
  }
}
