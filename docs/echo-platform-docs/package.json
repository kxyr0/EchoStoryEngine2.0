{
  "name": "echo-platform-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-stale.mjs && node scripts/build-search-index.mjs && astro build && node scripts/check-ui-language.mjs && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:check-stale": "node scripts/check-stale.mjs",
    "docs:build-search": "node scripts/build-search-index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "node scripts/check-stale.mjs && vitest run && node scripts/build-search-index.mjs && astro build && node scripts/check-ui-language.mjs && pagefind --site dist --output-subdir pagefind"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/preact": "^6.0.1",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/astro": "^1.25.0",
    "astro": "^7.1.0",
    "lenis": "^1.3.11",
    "motion": "^12.23.12",
    "pagefind": "^1.3.0",
    "preact": "^10.27.0",
    "shiki": "^3.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/preact": "^3.2.4",
    "axe-core": "^4.12.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
