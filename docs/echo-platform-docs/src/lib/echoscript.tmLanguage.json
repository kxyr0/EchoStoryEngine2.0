{
  "name": "EchoScript",
  "scopeName": "source.echoscript",
  "aliases": ["echoscript", "es"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#resourceLocation" },
    { "include": "#number" },
    { "include": "#enum" },
    { "include": "#argument" },
    { "include": "#method" },
    { "include": "#annotation" }
  ],
  "repository": {
    "annotation": {
      "name": "storage.modifier.annotation.echoscript",
      "match": "\\b(public|override|class|namespace|return)\\b"
    },
    "argument": {
      "name": "variable.parameter.argument.echoscript",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*:)"
    },
    "comment": {
      "name": "comment.line.double-slash.echoscript",
      "match": "//.*$"
    },
    "enum": {
      "name": "constant.language.enum.echoscript",
      "match": "\\b[A-Z][A-Z0-9_]+\\b"
    },
    "method": {
      "name": "entity.name.function.method.echoscript",
      "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "number": {
      "name": "constant.numeric.echoscript",
      "match": "\\b-?[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "resourceLocation": {
      "name": "constant.other.resource-location.echoscript",
      "match": "\\b[a-z0-9_.-]+:[a-z0-9_./-]+\\b"
    },
    "string": {
      "name": "string.quoted.double.echoscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.echoscript", "match": "\\\\." }
      ]
    }
  }
}
