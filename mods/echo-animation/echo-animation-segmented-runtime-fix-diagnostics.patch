+                        + " speed=" + playback.playbackSpeed)
+                .reduce((left, right) -> left + " | " + right)
+                .orElse("none");
+
+        source.sendSuccess(() -> Component.literal("Echo Animation subject " + subjectId
+                + ": profile=" + profileText
+                + ", rig=" + rigText
+                + " (" + rigDetails + ")"
