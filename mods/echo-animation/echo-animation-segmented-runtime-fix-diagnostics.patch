+    private int describeBodyRig(CommandSourceStack source, String rawId) {
+        AnimationRigId id;
+        try {
+            id = AnimationRigId.parse(rawId);
+        } catch (IllegalArgumentException exception) {
+            source.sendFailure(Component.literal(exception.getMessage()));
+            return 0;
+        }
+        Optional<AnimationRigDefinition> rig = catalogState.current().animationRigs().stream()
+                .filter(candidate -> candidate.id().equals(id))
+                .findFirst();
+        if (rig.isEmpty()) {
+            source.sendFailure(Component.literal("Body rig not found: " + id));
+            return 0;
+        }
+        AnimationRigDefinition definition = rig.orElseThrow();
+        String bones = definition.bones().stream()
+                .map(bone -> bone.id().value())
+                .reduce((left, right) -> left + "," + right)
+                .orElse("none");
+        source.sendSuccess(() -> Component.literal("Echo Animation body_rig " + id
+                + ": kind=" + definition.kind()
+                + ", skin=" + definition.skinVariant()
+                + ", bones=" + definition.bones().size()
+                + " [" + bones + "]"), false);
+        return 1;
+    }
+
+    private int describeBodyClip(CommandSourceStack source, String rawId) {
+        AnimationClipId id;
+        try {
+            id = AnimationClipId.parse(rawId);
+        } catch (IllegalArgumentException exception) {
+            source.sendFailure(Component.literal(exception.getMessage()));
+            return 0;
+        }
+        Optional<AnimationClipDefinition> clip = catalogState.current().animationClips().stream()
+                .filter(candidate -> candidate.id().equals(id))
+                .findFirst();
+        if (clip.isEmpty()) {
+            source.sendFailure(Component.literal("Body clip not found: " + id));
+            return 0;
+        }
+        AnimationClipDefinition definition = clip.orElseThrow();
+        int keys = definition.tracks().stream().mapToInt(track -> track.keyframes().size()).sum();
+        List<String> rotating = definition.tracks().stream()
+                .filter(this::hasNonZeroRotation)
+                .map(track -> track.boneId().value())
+                .toList();
+        List<String> translating = definition.tracks().stream()
+                .filter(this::hasNonZeroTranslation)
+                .map(track -> track.boneId().value())
+                .toList();
+        List<String> scaling = definition.tracks().stream()
+                .filter(this::hasNonIdentityScale)
+                .map(track -> track.boneId().value())
+                .toList();
+        long matrixTracks = definition.tracks().stream().filter(AnimationBoneTrackDefinition::matrixTrack).count();
+        source.sendSuccess(() -> Component.literal("Echo Animation body_clip " + id
+                + ": rig=" + definition.rigId().map(Object::toString).orElse("none")
+                + ", duration=" + definition.durationTicks()
+                + ", tracks=" + definition.tracks().size()
+                + ", keys=" + keys
+                + ", matrixTracks=" + matrixTracks
+                + ", rotating=" + rotating
+                + ", translating=" + translating
+                + ", scaling=" + scaling), false);
+        return 1;
+    }
+
+    private boolean hasNonZeroRotation(AnimationBoneTrackDefinition track) {
+        return track.keyframes().stream()
+                .flatMap(frame -> frame.rotationDegrees().stream())
+                .anyMatch(this::nonZero);
+    }
+
+    private boolean hasNonZeroTranslation(AnimationBoneTrackDefinition track) {
+        return track.keyframes().stream()
+                .flatMap(frame -> frame.translation().stream())
+                .anyMatch(this::nonZero);
+    }
+
+    private boolean hasNonIdentityScale(AnimationBoneTrackDefinition track) {
+        return track.keyframes().stream()
+                .flatMap(frame -> frame.scale().stream())
+                .anyMatch(value -> Math.abs(value.x() - 1.0D) > 1.0E-6D
+                        || Math.abs(value.y() - 1.0D) > 1.0E-6D
+                        || Math.abs(value.z() - 1.0D) > 1.0E-6D);
+    }
+
+    private boolean nonZero(Vec3 value) {
+        return Math.abs(value.x()) > 1.0E-6D
+                || Math.abs(value.y()) > 1.0E-6D
+                || Math.abs(value.z()) > 1.0E-6D;
+    }
