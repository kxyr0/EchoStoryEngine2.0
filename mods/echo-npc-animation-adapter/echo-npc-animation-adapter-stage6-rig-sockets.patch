index 0000000..b4a882e
--- /dev/null
+++ b/src/main/java/io/github/kxyr0/echonpcanimationadapter/client/NpcAnimationAttachmentBridge.java
@@ -0,0 +1,67 @@
+package io.github.kxyr0.echonpcanimationadapter.client;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import io.github.kxyr0.echoanimation.forge.api.client.render.attachment.AnimationAttachmentTransformSpace;
+import io.github.kxyr0.echoanimation.forge.api.client.render.AnimationBoneTransformProvider;
+import io.github.kxyr0.echoanimation.forge.api.client.render.attachment.AnimationHumanoidAttachmentAnchor;
+import io.github.kxyr0.echonpc.forge.api.client.attachment.NpcVisualAttachmentAnchor;
+import io.github.kxyr0.echonpc.forge.api.client.attachment.NpcVisualAttachmentTransformProvider;
+import io.github.kxyr0.echonpc.forge.api.client.attachment.NpcVisualAttachmentTransformSpace;
+import java.util.Objects;
+
+/** Converts stable NPC attachment semantics to the active animation rig socket contract. */
+final class NpcAnimationAttachmentBridge
+        implements NpcVisualAttachmentTransformProvider {
+
+    private final AnimationBoneTransformProvider bones;
+
+    NpcAnimationAttachmentBridge(
+            AnimationBoneTransformProvider bones) {
+
+        this.bones = Objects.requireNonNull(
+                bones,
+                "bones");
+    }
+
+    @Override
+    public void apply(
+            NpcVisualAttachmentAnchor anchor,
+            PoseStack poses) {
+
+        bones.applyAnchor(
+                animationAnchor(anchor),
+                poses);
+    }
+
+    @Override
+    public NpcVisualAttachmentTransformSpace space(
+            NpcVisualAttachmentAnchor anchor) {
+
+        AnimationAttachmentTransformSpace space =
+                bones.anchorSpace(
+                        animationAnchor(anchor));
+
+        return switch (space) {
+            case LEGACY_PART_RELATIVE ->
+                    NpcVisualAttachmentTransformSpace.PART_RELATIVE;
+
+            case MODEL_ABSOLUTE ->
+                    NpcVisualAttachmentTransformSpace.MODEL_ABSOLUTE;
+        };
+    }
+
+    static AnimationHumanoidAttachmentAnchor animationAnchor(
+            NpcVisualAttachmentAnchor anchor) {
+
+        return switch (Objects.requireNonNull(anchor, "anchor")) {
+            case TORSO_BACK ->
+                    AnimationHumanoidAttachmentAnchor.TORSO_BACK;
+
+            case LEFT_HAND ->
+                    AnimationHumanoidAttachmentAnchor.LEFT_HAND;
+
+            case RIGHT_HAND ->
+                    AnimationHumanoidAttachmentAnchor.RIGHT_HAND;
+        };
+    }
+}
diff --git a/src/test/java/io/github/kxyr0/echonpcanimationadapter/client/NpcAnimationAttachmentBridgeTest.java b/src/test/java/io/github/kxyr0/echonpcanimationadapter/client/NpcAnimationAttachmentBridgeTest.java
new file mode 100644
index 0000000..09a654d
--- /dev/null
+++ b/src/test/java/io/github/kxyr0/echonpcanimationadapter/client/NpcAnimationAttachmentBridgeTest.java
@@ -0,0 +1,55 @@
+package io.github.kxyr0.echonpcanimationadapter.client;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import io.github.kxyr0.echoanimation.forge.api.client.render.attachment.AnimationAttachmentTransformSpace;
+import io.github.kxyr0.echoanimation.forge.api.client.render.AnimationBoneTransformProvider;
+import io.github.kxyr0.echoanimation.forge.api.client.render.attachment.AnimationHumanoidAttachmentAnchor;
+import io.github.kxyr0.echonpc.forge.api.client.attachment.NpcVisualAttachmentAnchor;
+import io.github.kxyr0.echonpc.forge.api.client.attachment.NpcVisualAttachmentTransformSpace;
+import org.junit.jupiter.api.Test;
+
+final class NpcAnimationAttachmentBridgeTest {
+    @Test
+    void mapsNpcAnchorsToAnimationSemantics() {
+        assertEquals(
+                AnimationHumanoidAttachmentAnchor.TORSO_BACK,
+                NpcAnimationAttachmentBridge.animationAnchor(
+                        NpcVisualAttachmentAnchor.TORSO_BACK));
+        assertEquals(
+                AnimationHumanoidAttachmentAnchor.LEFT_HAND,
+                NpcAnimationAttachmentBridge.animationAnchor(
+                        NpcVisualAttachmentAnchor.LEFT_HAND));
+        assertEquals(
+                AnimationHumanoidAttachmentAnchor.RIGHT_HAND,
+                NpcAnimationAttachmentBridge.animationAnchor(
+                        NpcVisualAttachmentAnchor.RIGHT_HAND));
+    }
+
+    @Test
+    void carriesAbsoluteSocketSpaceAcrossAdapterBoundary() {
+        AnimationBoneTransformProvider bones =
+                new AnimationBoneTransformProvider() {
+                    @Override
+                    public void apply(
+                            String boneName,
+                            PoseStack poses) {
+                    }
+
+                    @Override
+                    public AnimationAttachmentTransformSpace anchorSpace(
+                            AnimationHumanoidAttachmentAnchor anchor) {
+
+                        return AnimationAttachmentTransformSpace.MODEL_ABSOLUTE;
+                    }
+                };
+
+        NpcAnimationAttachmentBridge bridge =
+                new NpcAnimationAttachmentBridge(bones);
+
+        assertEquals(
+                NpcVisualAttachmentTransformSpace.MODEL_ABSOLUTE,
+                bridge.space(NpcVisualAttachmentAnchor.LEFT_HAND));
+    }
+}
