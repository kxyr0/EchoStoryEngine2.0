diff --git a/src/main/java/io/github/kxyr0/echonpcanimationadapter/client/NpcAnimationAttachmentBridge.java b/src/main/java/io/github/kxyr0/echonpcanimationadapter/client/NpcAnimationAttachmentBridge.java
